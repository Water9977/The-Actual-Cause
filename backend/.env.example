# ==============================================================================
# SYNAPSE-OS Backend Environment Configuration
# ==============================================================================

# FalkorDB Cloud Configuration (from app.falkordb.cloud)
# Option 1: Full Connection URL (preferred for Cloud)
# Format: falkors://<username>:<password>@<host>:<port>
FALKORDB_URL=

# Option 2: Individual Connection Parameters
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_MASTER_GRAPH=enterprise_master

# LLM Swarm Settings (Google DeepMind)
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini/gemini-3.8-flash
FAST_LLM_MODEL=gemini/gemini-3.8-flash
REASONING_LLM_MODEL=gemini/gemini-3.8-flash

# API Server
PORT=8000
HOST=0.0.0.0
